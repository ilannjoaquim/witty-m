{% extends '@MauticCore/Default/content.html.twig' %}

{% block mauticContent 'witty' %}

{% block headerTitle %}{{ 'mautic.witty.chat.header'|trans }}{% endblock %}

{% block actions %}
    {% if isConfigured %}
        {% include '@MauticCore/Helper/button.html.twig' with {
            buttons: [
                {
                    label: 'mautic.witty.chat.new',
                    icon: 'ri-add-line',
                    variant: 'primary',
                    attributes: { id: 'witty-new', type: 'button' }
                }
            ]
        } %}
    {% endif %}
{% endblock %}

{% block content %}
<style>
    #witty-app { display: flex; gap: 16px; height: calc(100vh - 200px); min-height: 460px; }
    #witty-sidebar { width: 240px; flex: 0 0 240px; display: flex; flex-direction: column; }
    #witty-conversations { flex: 1; overflow-y: auto; border: 1px solid #e0e0e0; border-radius: 4px; background: #fff; }
    .witty-conv { display: flex; align-items: center; gap: 6px; padding: 8px 10px; border-bottom: 1px solid #f0f0f0; cursor: pointer; font-size: 13px; }
    .witty-conv:hover { background: #f6f8fb; }
    .witty-conv.active { background: #eef1f6; font-weight: 600; }
    .witty-conv-title { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .witty-conv-del { color: var(--button-danger-primary, #da1e28); opacity: .45; }
    .witty-conv-del:hover { opacity: 1; }
    #witty-search-wrap { position: relative; }
    #witty-search-results { position: absolute; top: 100%; left: 0; right: 0; z-index: 20; background: #fff; border: 1px solid #dfe3ea; border-radius: 4px; max-height: 320px; overflow-y: auto; display: none; box-shadow: 0 4px 10px rgba(0,0,0,.08); }
    #witty-search-results.open { display: block; }
    .witty-search-hit { padding: 8px 10px; border-bottom: 1px solid #f0f0f0; cursor: pointer; font-size: 12px; }
    .witty-search-hit:hover { background: #f6f8fb; }
    .witty-search-hit .title { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .witty-search-hit .snippet { color: #6b7280; margin-top: 2px; }
    .witty-search-hit .snippet mark { background: #fff3b0; padding: 0 1px; }
    .witty-search-empty { padding: 10px; font-size: 12px; color: #6b7280; }
    #witty-main { flex: 1; display: flex; flex-direction: column; min-width: 0; }
    #witty-log { flex: 1; overflow-y: auto; padding: 16px; background: #fff; border: 1px solid #e0e0e0; border-radius: 4px; }
    .witty-msg { max-width: 78%; margin-bottom: 14px; padding: 10px 14px; border-radius: 10px; line-height: 1.5; white-space: pre-wrap; word-wrap: break-word; }
    .witty-msg.user { margin-left: auto; background: var(--button-secondary, #393939); color: var(--button-secondary-text, #fff); }
    .witty-msg.assistant { background: var(--background-hover, #f2f4f8); color: var(--text-primary, #2b2b2b); white-space: normal; overflow-x: auto; }
    .witty-msg.assistant > *:first-child { margin-top: 0; }
    .witty-msg.assistant > *:last-child { margin-bottom: 0; }
    .witty-msg.assistant p { margin: 0 0 10px; }
    .witty-msg.assistant h1, .witty-msg.assistant h2, .witty-msg.assistant h3,
    .witty-msg.assistant h4, .witty-msg.assistant h5, .witty-msg.assistant h6 { margin: 14px 0 8px; line-height: 1.3; }
    .witty-msg.assistant hr { border: none; border-top: 1px solid #dfe3ea; margin: 12px 0; }
    .witty-msg.assistant ul, .witty-msg.assistant ol { margin: 0 0 10px; padding-left: 22px; }
    .witty-msg.assistant code { background: rgba(0,0,0,.06); border-radius: 3px; padding: 1px 4px; font-size: .9em; }
    .witty-msg.assistant pre { background: rgba(0,0,0,.06); border-radius: 6px; padding: 10px; overflow-x: auto; margin: 0 0 10px; }
    .witty-msg.assistant pre code { background: none; padding: 0; }
    .witty-msg.assistant table { border-collapse: collapse; width: 100%; margin: 0 0 10px; font-size: .95em; }
    .witty-msg.assistant th, .witty-msg.assistant td { border: 1px solid #dfe3ea; padding: 4px 8px; text-align: left; }
    .witty-msg.assistant a { color: inherit; text-decoration: underline; }
    .witty-msg.error { background: #fdecea; color: #a5261c; border: 1px solid #f5c6c2; }
    .witty-trace { margin: 6px 0 14px; font-size: 12px; color: #6b7280; }
    .witty-chip { display: inline-block; margin: 2px 4px 2px 0; padding: 2px 8px; border-radius: 10px; background: #eef1f6; border: 1px solid #dfe3ea; }
    .witty-chip.running { background: #fff8e1; border-color: #f3e2a9; }
    .witty-chip.error, .witty-chip.denied { background: #fdecea; border-color: #f5c6c2; color: #a5261c; }
    #witty-form { display: flex; gap: 8px; margin-top: 12px; }
    #witty-input { flex: 1; resize: none; }
    #witty-meta { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 12px; color: #6b7280; margin-bottom: 6px; flex-wrap: wrap; }
    #witty-model-select { display: flex; align-items: center; gap: 6px; }
    #witty-model-select select.form-control { width: auto; height: auto; padding: 4px 8px; font-size: 12px; }
    #witty-model { min-width: 190px; }
    .witty-cursor::after { content: '▍'; animation: witty-blink 1s step-start infinite; }
    @keyframes witty-blink { 50% { opacity: 0; } }
</style>

<div id="witty-app"
     data-stream-endpoint="{{ path('witty_chat_stream') }}"
     data-send-endpoint="{{ path('witty_chat_send') }}"
     data-list-endpoint="{{ path('witty_conversations') }}"
     data-conversation-endpoint="{{ path('witty_conversation', {'id': 0}) }}"
     data-delete-endpoint="{{ path('witty_conversation_delete', {'id': 0}) }}"
     data-search-endpoint="{{ path('witty_search') }}"
     data-models-endpoint="{{ path('witty_models', {'provider': '__provider__'}) }}"
     data-streaming="{{ streaming ? '1' : '0' }}"
     data-configured="{{ isConfigured ? '1' : '0' }}"
     data-default-provider="{{ defaultProvider }}"
     data-providers="{{ providers|json_encode }}">

    <div id="witty-sidebar">
        <div id="witty-search-wrap" class="mb-10">
            <div class="input-group d-flex">
                <span class="input-group-addon"><i class="ri-search-line" aria-hidden="true"></i></span>
                <input type="search" id="witty-search" class="form-control search" placeholder="{{ 'mautic.witty.chat.search'|trans }}" autocomplete="false" {{ isConfigured ? '' : 'disabled' }}>
            </div>
            <div id="witty-search-results"></div>
        </div>
        <div id="witty-conversations">
            {% for conversation in conversations %}
                <div class="witty-conv" data-id="{{ conversation.id }}">
                    <span class="witty-conv-title" title="{{ conversation.title }}">{{ conversation.title }}</span>
                    <i class="ri-delete-bin-line witty-conv-del" data-delete="{{ conversation.id }}"></i>
                </div>
            {% endfor %}
        </div>
    </div>

    <div id="witty-main">
        {% if not isConfigured %}
            <div class="alert alert-warning">{{ 'mautic.witty.chat.not_configured'|trans }}</div>
        {% else %}
            <div id="witty-meta">
                <div id="witty-model-select">
                    <!-- class="not-chosen" : sans ca, Mautic remplace ce <select> par un widget
                         Chosen fige au chargement (app/bundles/CoreBundle/Assets/js/1a.content.js),
                         qui ne reflete jamais les options ajoutees dynamiquement en JS ensuite. -->
                    <select id="witty-provider" class="not-chosen form-control input-sm" title="{{ 'mautic.witty.chat.provider'|trans }}">
                        {% for provider in providers %}
                            <option value="{{ provider.key }}">{{ provider.label }}</option>
                        {% endfor %}
                    </select>
                    <select id="witty-model" class="not-chosen form-control input-sm" title="{{ 'mautic.witty.chat.model'|trans }}"></select>
                    {% if not streaming %}<span>&middot; {{ 'mautic.witty.chat.streaming_off'|trans }}</span>{% endif %}
                </div>
                <span id="witty-usage" data-quota="{{ usage.quota }}" data-used="{{ usage.used }}">
                    {%- if usage.quota > 0 -%}
                        {{ usage.used }} / {{ usage.quota }} tokens
                    {%- else -%}
                        {{ usage.used }} tokens
                    {%- endif -%}
                </span>
            </div>
        {% endif %}

        <div id="witty-log"></div>

        <div id="witty-form">
            <textarea id="witty-input" class="form-control" rows="2"
                      placeholder="{{ 'mautic.witty.chat.placeholder'|trans }}"
                      {{ isConfigured ? '' : 'disabled' }}></textarea>
            <button id="witty-send" class="btn btn-primary" {{ isConfigured ? '' : 'disabled' }}>
                {{ 'mautic.witty.chat.send'|trans }}
            </button>
        </div>
    </div>
</div>

<script>
(function () {
    var app = document.getElementById('witty-app');
    if (!app || app.dataset.wittyReady === '1') { return; }
    app.dataset.wittyReady = '1';

    var log            = document.getElementById('witty-log');
    var input          = document.getElementById('witty-input');
    var send           = document.getElementById('witty-send');
    var list           = document.getElementById('witty-conversations');
    var usageEl        = document.getElementById('witty-usage');
    var providerSelect = document.getElementById('witty-provider');
    var modelSelect     = document.getElementById('witty-model');
    var streaming      = app.dataset.streaming === '1';

    // Fournisseurs pour lesquels une cle API est renseignee, envoyes par le
    // serveur ; vide si aucune n'est configuree (formulaire alors masque).
    var providers = [];
    try { providers = JSON.parse(app.dataset.providers || '[]'); } catch (e) { providers = []; }

    var STORAGE_PROVIDER = 'witty.provider';
    var STORAGE_MODEL    = 'witty.model';

    // Le transcript vit desormais en base : le navigateur ne garde que
    // l'identifiant du fil courant.
    var conversationId = null;
    var busy           = false;

    function providerByKey(key) {
        for (var i = 0; i < providers.length; i++) {
            if (providers[i].key === key) { return providers[i]; }
        }
        return null;
    }

    function populateModels(models, selectedValue) {
        modelSelect.innerHTML = '';

        models.forEach(function (model) {
            var opt = document.createElement('option');
            opt.value = model.id;
            opt.textContent = model.label || model.id;
            modelSelect.appendChild(opt);
        });

        if (selectedValue && models.some(function (model) { return model.id === selectedValue; })) {
            modelSelect.value = selectedValue;
        }
    }

    // Catalogue recupere en direct depuis l'API du fournisseur (cf. ModelCatalog
    // cote serveur, qui met en cache et replie sur le modele configure si
    // l'appel echoue) : le menu n'est donc jamais vide, meme hors ligne.
    //
    // Tout est protege par un try/catch synchrone + un timeout cote client :
    // sans ca, la moindre exception avant l'attache du fetch (ou une requete
    // qui ne repond jamais) laisse le select desactive indefiniment, sans
    // aucun moyen de s'en sortir.
    function loadModels(providerKey, modelOverride) {
        var provider = providerByKey(providerKey);
        if (!provider) { return Promise.resolve(); }

        function releaseWithFallback() {
            populateModels([{ id: provider.model, label: provider.model }], provider.model);
            modelSelect.disabled = false;
        }

        modelSelect.disabled = true;

        var url;
        try {
            populateModels([{ id: provider.model, label: '…' }], provider.model);
            url = app.dataset.modelsEndpoint.replace('__provider__', providerKey);
        } catch (e) {
            releaseWithFallback();
            return Promise.resolve();
        }

        var controller = ('AbortController' in window) ? new AbortController() : null;
        var timeout = setTimeout(function () { if (controller) { controller.abort(); } }, 15000);

        return fetch(url, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            signal: controller ? controller.signal : undefined
        })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                var models = (data.models && data.models.length) ? data.models : [{ id: data.default || provider.model, label: data.default || provider.model }];
                populateModels(models, modelOverride || data.default || provider.model);
                modelSelect.disabled = false;
            })
            .catch(releaseWithFallback)
            .finally(function () { clearTimeout(timeout); modelSelect.disabled = false; });
    }

    function applyProvider(providerKey, modelOverride) {
        var provider = providerByKey(providerKey) || providers[0];
        if (!provider) { return; }

        providerSelect.value = provider.key;
        loadModels(provider.key, modelOverride);
    }

    function persistSelection() {
        try {
            localStorage.setItem(STORAGE_PROVIDER, providerSelect.value);
            localStorage.setItem(STORAGE_MODEL, modelSelect.value);
        } catch (e) { /* stockage indisponible (navigation privee, quota) : tant pis */ }
    }

    if (providers.length) {
        var storedProvider = null;
        var storedModel    = null;
        try {
            storedProvider = localStorage.getItem(STORAGE_PROVIDER);
            storedModel    = localStorage.getItem(STORAGE_MODEL);
        } catch (e) { /* ignore */ }

        // Un fournisseur mémorisé mais dont la clé a été retirée depuis ne
        // doit pas rester sélectionné silencieusement.
        var initialProvider = (storedProvider && providerByKey(storedProvider)) ? storedProvider : app.dataset.defaultProvider;
        applyProvider(initialProvider, providerByKey(initialProvider) ? storedModel : null);

        providerSelect.addEventListener('change', function () {
            applyProvider(providerSelect.value, null);
            persistSelection();
        });
        modelSelect.addEventListener('change', persistSelection);
    }

    function headers() {
        return {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
            // Mautic rejette tout POST ajax vers /s/ sans ce jeton.
            'X-CSRF-Token': window.mauticAjaxCsrf || ''
        };
    }

    // Rendu markdown -> HTML minimal, sans dependance externe. Le texte brut
    // est echappe AVANT toute transformation : ce qu'on injecte ensuite comme
    // balises vient de nous, jamais du modele, donc pas de risque XSS meme
    // si le texte du LLM contient du HTML (ex. reflet d'un contenu tiers via
    // un outil, injection de prompt...).
    function mdEscapeHtml(value) {
        var div = document.createElement('div');
        div.textContent = value == null ? '' : String(value);
        return div.innerHTML;
    }

    function mdInline(text) {
        text = text.replace(/`([^`]+)`/g, function (m, code) { return '<code>' + code + '</code>'; });
        text = text.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, function (m, label, url) {
            return '<a href="' + url + '" target="_blank" rel="noopener noreferrer">' + label + '</a>';
        });
        text = text.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
        text = text.replace(/__([^_]+)__/g, '<strong>$1</strong>');
        text = text.replace(/\*([^*]+)\*/g, '<em>$1</em>');
        return text;
    }

    function renderMarkdown(raw) {
        var lines = mdEscapeHtml(raw).split('\n');
        var html = '';
        var paragraph = [];
        var i = 0;

        function flushParagraph() {
            if (paragraph.length) {
                html += '<p>' + mdInline(paragraph.join('<br>')) + '</p>';
                paragraph = [];
            }
        }

        while (i < lines.length) {
            var line = lines[i];

            if (/^```/.test(line)) {
                flushParagraph();
                var code = [];
                i++;
                while (i < lines.length && !/^```/.test(lines[i])) { code.push(lines[i]); i++; }
                html += '<pre><code>' + code.join('\n') + '</code></pre>';
                i++;
                continue;
            }

            if (/^\s*([-*_])\s*(\1\s*){2,}$/.test(line)) {
                flushParagraph();
                html += '<hr>';
                i++;
                continue;
            }

            var headerMatch = line.match(/^(#{1,6})\s+(.*)$/);
            if (headerMatch) {
                flushParagraph();
                var level = headerMatch[1].length;
                html += '<h' + level + '>' + mdInline(headerMatch[2]) + '</h' + level + '>';
                i++;
                continue;
            }

            if (/^\s*\|(.+)\|\s*$/.test(line) && lines[i + 1] && /^\s*\|[\s:|-]+\|\s*$/.test(lines[i + 1])) {
                flushParagraph();
                var splitRow = function (row) {
                    return row.trim().replace(/^\||\|$/g, '').split('|').map(function (c) { return c.trim(); });
                };
                html += '<table><thead><tr>' + splitRow(line).map(function (c) { return '<th>' + mdInline(c) + '</th>'; }).join('') + '</tr></thead><tbody>';
                i += 2;
                while (i < lines.length && /^\s*\|(.+)\|\s*$/.test(lines[i])) {
                    html += '<tr>' + splitRow(lines[i]).map(function (c) { return '<td>' + mdInline(c) + '</td>'; }).join('') + '</tr>';
                    i++;
                }
                html += '</tbody></table>';
                continue;
            }

            if (/^\s*[-*]\s+/.test(line)) {
                flushParagraph();
                html += '<ul>';
                while (i < lines.length && /^\s*[-*]\s+/.test(lines[i])) {
                    html += '<li>' + mdInline(lines[i].replace(/^\s*[-*]\s+/, '')) + '</li>';
                    i++;
                }
                html += '</ul>';
                continue;
            }

            if (/^\s*\d+\.\s+/.test(line)) {
                flushParagraph();
                html += '<ol>';
                while (i < lines.length && /^\s*\d+\.\s+/.test(lines[i])) {
                    html += '<li>' + mdInline(lines[i].replace(/^\s*\d+\.\s+/, '')) + '</li>';
                    i++;
                }
                html += '</ol>';
                continue;
            }

            if (/^\s*$/.test(line)) {
                flushParagraph();
                i++;
                continue;
            }

            paragraph.push(line);
            i++;
        }

        flushParagraph();
        return html;
    }

    // L'assistant peut contenir du markdown ; l'utilisateur et les erreurs
    // restent en texte brut (pas de raison d'interpreter la saisie de
    // l'utilisateur comme du markup, et ca evite un aller-retour escape/parse
    // inutile). `dataset.raw` garde la source pour les mises a jour
    // incrementales du streaming (cf. consumeStream).
    function renderBubbleText(el, text) {
        el.dataset.raw = text;
        if (el.classList.contains('assistant')) {
            el.innerHTML = renderMarkdown(text);
        } else {
            el.textContent = text;
        }
    }

    function bubble(text, kind) {
        var el = document.createElement('div');
        el.className = 'witty-msg ' + kind;
        renderBubbleText(el, text);
        log.appendChild(el);
        log.scrollTop = log.scrollHeight;
        return el;
    }

    function chip(entry) {
        var el = document.createElement('span');
        el.className = 'witty-chip ' + (entry.state === 'running' ? 'running' : (entry.status || ''));
        el.textContent = entry.label || entry.tool;
        el.dataset.tool = entry.tool;
        return el;
    }

    function traceContainer() {
        var wrap = document.createElement('div');
        wrap.className = 'witty-trace';
        log.appendChild(wrap);
        return wrap;
    }

    function setUsage(usage) {
        if (!usageEl || !usage) { return; }
        var quota = parseInt(usageEl.dataset.quota || '0', 10);
        var used  = parseInt(usageEl.dataset.used || '0', 10) + (usage.total || 0);
        usageEl.dataset.used = used;
        usageEl.textContent  = quota > 0 ? (used + ' / ' + quota + ' tokens') : (used + ' tokens');
    }

    function markActive(id) {
        conversationId = id || null;
        Array.prototype.forEach.call(list.querySelectorAll('.witty-conv'), function (el) {
            el.classList.toggle('active', String(el.dataset.id) === String(id));
        });
    }

    function refreshConversations(activeId) {
        return fetch(app.dataset.listEndpoint, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                list.innerHTML = '';
                (data.conversations || []).forEach(function (conversation) {
                    var row = document.createElement('div');
                    row.className = 'witty-conv';
                    row.dataset.id = conversation.id;

                    var title = document.createElement('span');
                    title.className = 'witty-conv-title';
                    title.title = conversation.title;
                    title.textContent = conversation.title;

                    var del = document.createElement('i');
                    del.className = 'ri-delete-bin-line witty-conv-del';
                    del.dataset.delete = conversation.id;

                    row.appendChild(title);
                    row.appendChild(del);
                    list.appendChild(row);
                });
                markActive(activeId || conversationId);
            });
    }

    function openConversation(id) {
        var url = app.dataset.conversationEndpoint.replace(/0$/, id);

        return fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                log.innerHTML = '';
                (data.transcript || []).forEach(function (message) {
                    bubble(message.text, message.role === 'user' ? 'user' : 'assistant');
                    if (message.tools && message.tools.length) {
                        var wrap = traceContainer();
                        message.tools.forEach(function (tool) {
                            wrap.appendChild(chip({ tool: tool, label: tool }));
                        });
                    }
                });
                markActive(id);

                // Rouvrir un fil replace les selecteurs sur ce qu'il a utilise
                // en dernier ; l'utilisateur peut toujours en changer ensuite,
                // pour ce tour comme pour les suivants.
                if (providers.length && data.provider && providerByKey(data.provider)) {
                    applyProvider(data.provider, data.model);
                }
            });
    }

    function deleteConversation(id) {
        var url = app.dataset.deleteEndpoint.replace(/0\/delete$/, id + '/delete');

        return fetch(url, { method: 'POST', headers: headers() })
            .then(function () {
                if (String(conversationId) === String(id)) {
                    conversationId = null;
                    log.innerHTML = '';
                }
                return refreshConversations();
            });
    }

    list.addEventListener('click', function (event) {
        var del = event.target.closest('[data-delete]');
        if (del) {
            event.stopPropagation();
            deleteConversation(del.dataset.delete);
            return;
        }

        var row = event.target.closest('.witty-conv');
        if (row) { openConversation(row.dataset.id); }
    });

    // ---- Recherche dans l'historique des messages ----

    var searchInput   = document.getElementById('witty-search');
    var searchResults = document.getElementById('witty-search-results');
    var searchTimer   = null;
    var searchSeq     = 0;

    function escapeHtml(value) {
        var div = document.createElement('div');
        div.textContent = value == null ? '' : String(value);
        return div.innerHTML;
    }

    // Encadre la premiere occurrence du terme cherche dans l'extrait renvoye
    // par le serveur (deja escape ici, donc <mark> ajoute ensuite est sans
    // risque d'injection).
    function highlight(snippet, term) {
        var escaped = escapeHtml(snippet);
        var pattern = term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        return escaped.replace(new RegExp('(' + pattern + ')', 'ig'), '<mark>$1</mark>');
    }

    function closeSearch() {
        searchResults.classList.remove('open');
        searchResults.innerHTML = '';
    }

    function runSearch(term) {
        var seq = ++searchSeq;

        fetch(app.dataset.searchEndpoint + '?q=' + encodeURIComponent(term), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (seq !== searchSeq) { return; } // une frappe plus recente a deja relance une recherche

                var results = data.results || [];

                if (!results.length) {
                    searchResults.innerHTML = '<div class="witty-search-empty">{{ 'mautic.witty.chat.search_empty'|trans|e('js') }}</div>';
                    searchResults.classList.add('open');
                    return;
                }

                searchResults.innerHTML = results.map(function (hit) {
                    return '<div class="witty-search-hit" data-id="' + hit.conversation_id + '">' +
                        '<div class="title">' + escapeHtml(hit.title) + '</div>' +
                        '<div class="snippet">' + highlight(hit.snippet, term) + '</div>' +
                    '</div>';
                }).join('');
                searchResults.classList.add('open');

                searchResults.querySelectorAll('.witty-search-hit').forEach(function (el) {
                    el.addEventListener('click', function () {
                        openConversation(el.dataset.id);
                        refreshConversations(el.dataset.id);
                        closeSearch();
                        searchInput.value = '';
                    });
                });
            })
            .catch(function () { /* recherche best-effort : une erreur reseau ne doit rien casser */ });
    }

    searchInput.addEventListener('input', function () {
        var term = searchInput.value.trim();
        clearTimeout(searchTimer);

        if (!term) { closeSearch(); return; }

        searchTimer = setTimeout(function () { runSearch(term); }, 300);
    });

    document.addEventListener('click', function (event) {
        if (!event.target.closest('#witty-search-wrap')) { closeSearch(); }
    });

    // Absent quand isConfigured est faux : le bouton n'est alors pas rendu
    // du tout dans le bloc actions (cf. page-header), pas juste desactive.
    var newBtn = document.getElementById('witty-new');
    if (newBtn) {
        newBtn.addEventListener('click', function () {
            log.innerHTML = '';
            markActive(null);
            input.focus();
        });
    }

    function finish() {
        busy = false;
        send.disabled = false;
        input.focus();
    }

    /**
     * Decoupe le flux SSE en evenements. Une trame peut arriver en plusieurs
     * morceaux et plusieurs trames dans le meme morceau : on accumule.
     */
    function consumeStream(response, handle) {
        var reader  = response.body.getReader();
        var decoder = new TextDecoder();
        var buffer  = '';

        function pump() {
            return reader.read().then(function (result) {
                if (result.done) { return; }

                buffer += decoder.decode(result.value, { stream: true });

                var frames = buffer.split('\n\n');
                buffer = frames.pop();

                frames.forEach(function (frame) {
                    var event = 'message';
                    var data  = '';

                    frame.split('\n').forEach(function (line) {
                        if (line.indexOf('event: ') === 0) { event = line.slice(7).trim(); }
                        if (line.indexOf('data: ') === 0) { data += line.slice(6); }
                    });

                    if (!data) { return; }

                    try { handle(event, JSON.parse(data)); } catch (e) { /* trame illisible : on ignore */ }
                });

                return pump();
            });
        }

        return pump();
    }

    function submit() {
        var message = input.value.trim();
        if (!message || busy) { return; }

        busy = true;
        send.disabled = true;
        input.value = '';
        bubble(message, 'user');

        var pending = bubble('', 'assistant');
        pending.classList.add('witty-cursor');
        var trace = null;

        var body = {
            message: message,
            conversation_id: conversationId,
            provider: providers.length ? providerSelect.value : null,
            model: providers.length ? modelSelect.value.trim() : null
        };

        var request = fetch(streaming ? app.dataset.streamEndpoint : app.dataset.sendEndpoint, {
            method: 'POST',
            headers: headers(),
            body: JSON.stringify(body)
        });

        if (!streaming) {
            request.then(function (response) {
                return response.json().then(function (data) { return { ok: response.ok, data: data }; });
            }).then(function (result) {
                pending.classList.remove('witty-cursor');
                if (!result.ok) {
                    pending.remove();
                    bubble(result.data.error || 'Erreur inconnue.', 'error');
                    return;
                }
                renderBubbleText(pending, result.data.reply);
                if (result.data.trace && result.data.trace.length) {
                    var wrap = traceContainer();
                    result.data.trace.forEach(function (entry) { wrap.appendChild(chip(entry)); });
                }
                setUsage(result.data.usage);
                refreshConversations(result.data.conversation_id);
            }).catch(function (error) {
                pending.remove();
                bubble('Erreur reseau : ' + error.message, 'error');
            }).finally(finish);

            return;
        }

        request.then(function (response) {
            if (!response.ok || !response.body) {
                return response.json().then(function (data) {
                    throw new Error(data.error || ('HTTP ' + response.status));
                });
            }

            return consumeStream(response, function (event, data) {
                if (event === 'delta') {
                    renderBubbleText(pending, (pending.dataset.raw || '') + data.text);
                    log.scrollTop = log.scrollHeight;
                } else if (event === 'tool') {
                    trace = trace || traceContainer();
                    var running = trace.querySelector('[data-tool="' + data.tool + '"].running');
                    if (data.state === 'done' && running) {
                        running.replaceWith(chip(data));
                    } else if (data.state === 'running') {
                        trace.appendChild(chip(data));
                    }
                    log.scrollTop = log.scrollHeight;
                } else if (event === 'usage') {
                    setUsage(data);
                } else if (event === 'done') {
                    pending.classList.remove('witty-cursor');
                    if (data.reply && !pending.dataset.raw) { renderBubbleText(pending, data.reply); }
                    refreshConversations(data.conversation_id);
                } else if (event === 'error') {
                    pending.classList.remove('witty-cursor');
                    if (!pending.dataset.raw) { pending.remove(); }
                    bubble(data.error || 'Erreur inconnue.', 'error');
                    if (data.conversation_id) { refreshConversations(data.conversation_id); }
                }
            });
        }).catch(function (error) {
            pending.classList.remove('witty-cursor');
            if (!pending.dataset.raw) { pending.remove(); }
            bubble('Erreur : ' + error.message, 'error');
        }).finally(finish);
    }

    send.addEventListener('click', submit);
    input.addEventListener('keydown', function (event) {
        if (event.key === 'Enter' && !event.shiftKey) {
            event.preventDefault();
            submit();
        }
    });
})();
</script>
{% endblock %}
