{#
  Champ "Creneau de rendez-vous" (type: witty.meet_slot_picker).

  Rendu minimal en pur JS (pas de dependance jQuery : les formulaires publics
  Mautic n'en garantissent pas la presence). Un input cache porte la valeur
  reellement soumise (mauticform[{alias}], format ISO 8601) ; le calendrier
  (mois navigable + creneaux du jour selectionne) n'est qu'une interface
  au-dessus, alimentee par /witty/meet/slots/{fieldId}?month=YYYY-MM.

  Variables (cf. Builder/form.html.twig) :
    - field (tableau, Field::convertToArray)
    - formName (absent dans le rendu "ajout d'un nouveau champ" du builder,
      cf. Builder/_field_wrapper.html.twig -> defaut defensif ci-dessous)
    - id (= field.alias sur le formulaire publie, = field.id temporaire dans
      le builder avant enregistrement)
    - inBuilder
    - inForm (true quand ce rendu est l'apercu dans l'onglet "Fields" du
      builder, cf. Builder/index.html.twig et _field_wrapper.html.twig) :
      cet apercu est imbrique DANS le <form> du formulaire d'edition Mautic
      lui-meme (form_start(form) tout en haut de Builder/index.html.twig).
      Un input actif ici serait donc soumis en plus des champs attendus par
      ce formulaire d'edition au moment du Save -> "This form should not
      contain extra fields." Meme convention que Field/text.html.twig :
      l'input de l'apercu doit etre disabled pour ne jamais etre serialise.
    - language (optionnel, absent dans le rendu builder)

  Personnalisation visuelle : toutes les couleurs/espacements sont des
  variables CSS declarees sur .witty-slot-picker (voir le bloc <style>
  ci-dessous). Un theme peut les redefinir par simple surcharge CSS, ex. :
    .mauticform-row.mauticform-witty_meet_slot_picker .witty-slot-picker {
      --witty-accent: #ff6600;
    }
  (selecteur volontairement peu specifique cote plugin pour rester facile a
  surcharger).
#}
{% set formName = formName|default('') %}
{% set order = field.order|default(0) %}
{% set inputName = 'mauticform[' ~ field.alias ~ ']' %}
{% set inputId = 'mauticform_input' ~ formName ~ '_' ~ field.alias %}
{% set containerId = 'mauticform' ~ formName ~ '_' ~ id %}
{% set widgetId = 'witty-slot-picker' ~ formName ~ '_' ~ field.alias %}

{% set containerAttributes = htmlAttributesStringToArray(field.containerAttributes|default('')) %}
{% set containerClass = (containerAttributes.class|default('') ~ ' mauticform-row mauticform-witty_meet_slot_picker mauticform-field-' ~ order)|trim %}

<div id="{{ containerId }}" class="{{ containerClass }}" style="width: {{ field.fieldWidth }}"
     {% if field.isRequired %}data-validate="{{ field.alias }}" data-validation-type="{{ field.type }}"{% endif %}>
  {% if field.showLabel %}<label id="mauticform_label{{ formName }}_{{ field.alias }}" for="{{ inputId }}" class="mauticform-label">{{ field.label|purify_allow_target_blank }}</label>{% endif %}

  {% if field.helpMessage is not empty %}<span class="mauticform-helpmessage">{{ field.helpMessage|purify_allow_target_blank }}</span>{% endif %}

  <input type="hidden" name="{{ inputName }}" id="{{ inputId }}" value="" {% if inForm is defined and inForm %}disabled="disabled"{% endif %} />
  {# Champ brut (pas un vrai champ Mautic, jamais expose comme {formfield=...}) :
     seul MeetSlotValidationSubscriber le lit, pour ecrire le fuseau choisi par
     le visiteur dans le champ contact meeting_scheduled_visitor_at. #}
  <input type="hidden" name="mauticform[{{ field.alias }}__visitor_tz]" id="{{ inputId }}__visitor_tz" value="" {% if inForm is defined and inForm %}disabled="disabled"{% endif %} />

  {% if inBuilder %}
    <div class="alert alert-info witty-slot-picker-builder-note">{{ 'mautic.witty.meet.slotpicker.builder_placeholder'|trans }}</div>
  {% else %}
    <div id="{{ widgetId }}" class="witty-slot-picker" data-field-id="{{ field.id }}" data-input-id="{{ inputId }}" data-container-id="{{ containerId }}"
         data-slots-url="{{ url('witty_meet_slots_availability', {'fieldId': field.id}) }}"
         data-label-loading="{{ 'mautic.witty.meet.slotpicker.loading'|trans }}"
         data-label-empty="{{ 'mautic.witty.meet.slotpicker.no_slots'|trans }}"
         data-label-error="{{ 'mautic.witty.meet.slotpicker.load_error'|trans }}"
         data-label-selected="{{ 'mautic.witty.meet.slotpicker.selected'|trans }}"
         data-label-select-date="{{ 'mautic.witty.meet.slotpicker.select_date'|trans }}"
         data-label-prev="{{ 'mautic.witty.meet.slotpicker.prev_month'|trans }}"
         data-label-next="{{ 'mautic.witty.meet.slotpicker.next_month'|trans }}"
         data-label-your-timezone="{{ 'mautic.witty.meet.slotpicker.your_timezone'|trans }}"
         data-locale="{{ language|default('en') }}"
         data-visitor-tz-input-id="{{ inputId }}__visitor_tz">
      <div class="witty-slot-picker-tz">
        <label class="witty-slot-picker-tz-label"></label>
        <select class="witty-slot-picker-tz-select"></select>
      </div>
      <div class="witty-slot-picker-calendar">
        <div class="witty-slot-picker-cal-header">
          <button type="button" class="witty-slot-picker-nav witty-slot-picker-prev" aria-label="{{ 'mautic.witty.meet.slotpicker.prev_month'|trans }}">&lsaquo;</button>
          <span class="witty-slot-picker-month-label"></span>
          <button type="button" class="witty-slot-picker-nav witty-slot-picker-next" aria-label="{{ 'mautic.witty.meet.slotpicker.next_month'|trans }}">&rsaquo;</button>
        </div>
        <div class="witty-slot-picker-weekdays"></div>
        <div class="witty-slot-picker-grid"></div>
      </div>
      <div class="witty-slot-picker-times-panel">
        <div class="witty-slot-picker-times-title"></div>
        <div class="witty-slot-picker-times"></div>
      </div>
      <div class="witty-slot-picker-status" role="status" aria-live="polite"></div>
    </div>
  {% endif %}

  <span class="mauticform-errormsg" aria-live="polite" aria-atomic="true" aria-hidden="true" style="display:none;">{{ field.validationMessage }}</span>
</div>

{% if not inBuilder %}
<style type="text/css">
  .witty-slot-picker {
    --witty-accent: #4e5e9e;
    --witty-accent-contrast: #ffffff;
    --witty-border: #e0e0e0;
    --witty-bg: #ffffff;
    --witty-text: #333333;
    --witty-muted: #9aa0a6;
    --witty-radius: 6px;
    --witty-gap: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: var(--witty-gap);
    margin-top: 8px;
    max-width: 560px;
    box-sizing: border-box;
  }
  .witty-slot-picker * { box-sizing: border-box; }
  .witty-slot-picker-tz {
    flex-basis: 100%;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--witty-muted);
  }
  .witty-slot-picker-tz-select {
    font-size: 12px;
    padding: 4px 6px;
    border: 1px solid var(--witty-border);
    border-radius: var(--witty-radius);
    color: var(--witty-text);
    background: var(--witty-bg);
  }
  .witty-slot-picker-calendar {
    flex: 1 1 260px;
    min-width: 240px;
    border: 1px solid var(--witty-border);
    border-radius: var(--witty-radius);
    padding: 12px;
    background: var(--witty-bg);
  }
  .witty-slot-picker-cal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    font-weight: 600;
    color: var(--witty-text);
    font-size: 14px;
  }
  .witty-slot-picker-nav {
    border: none;
    background: transparent;
    cursor: pointer;
    font-size: 18px;
    line-height: 1;
    padding: 4px 10px;
    border-radius: var(--witty-radius);
    color: var(--witty-text);
  }
  .witty-slot-picker-nav:hover:not(:disabled) { background: var(--witty-border); }
  .witty-slot-picker-nav:disabled { opacity: .3; cursor: default; }
  .witty-slot-picker-weekdays, .witty-slot-picker-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
    text-align: center;
  }
  .witty-slot-picker-weekdays {
    margin-bottom: 4px;
    font-size: 11px;
    color: var(--witty-muted);
    text-transform: uppercase;
  }
  .witty-slot-picker-day-cell {
    border: none;
    background: transparent;
    padding: 8px 0;
    border-radius: var(--witty-radius);
    cursor: pointer;
    font-size: 13px;
    color: var(--witty-text);
  }
  .witty-slot-picker-day-cell:disabled { color: var(--witty-muted); cursor: default; opacity: .35; }
  .witty-slot-picker-day-cell.is-outside { visibility: hidden; }
  .witty-slot-picker-day-cell:hover:not(:disabled) { background: var(--witty-border); }
  .witty-slot-picker-day-cell.is-selected { background: var(--witty-accent); color: var(--witty-accent-contrast); }
  .witty-slot-picker-times-panel { flex: 1 1 180px; min-width: 160px; }
  .witty-slot-picker-times-title {
    font-weight: 600;
    margin-bottom: 8px;
    color: var(--witty-text);
    font-size: 13px;
    min-height: 1.2em;
  }
  .witty-slot-picker-times {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: 280px;
    overflow-y: auto;
  }
  .witty-slot-picker-time {
    border: 1px solid var(--witty-border);
    background: var(--witty-bg);
    border-radius: var(--witty-radius);
    padding: 8px 12px;
    cursor: pointer;
    font-size: 13px;
    color: var(--witty-text);
    text-align: center;
  }
  .witty-slot-picker-time:hover { border-color: var(--witty-accent); }
  .witty-slot-picker-time.is-selected { background: var(--witty-accent); border-color: var(--witty-accent); color: var(--witty-accent-contrast); }
  .witty-slot-picker-status { flex-basis: 100%; font-size: 13px; color: var(--witty-muted); }
</style>
<script type="text/javascript">
(function () {
  // Le theme/la page peut deplacer ce <script> avant le <div> qu'il cible
  // dans le HTML final (constate en pratique) : on ne peut pas supposer que
  // le DOM environnant est deja parse au moment ou ce script s'execute.
  if ('loading' === document.readyState) {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  function init() {
  var widget = document.getElementById({{ widgetId|json_encode|raw }});
  if (!widget || widget.getAttribute('data-witty-initialized')) {
    return;
  }
  widget.setAttribute('data-witty-initialized', '1');

  // Meme fenetre max que MeetSlotAvailabilityCalculator::MAX_ADVANCE_DAYS
  // (180 jours ~ 6 mois) : juste pour desactiver la navigation "suivant" au
  // bon endroit, la vraie limite reste appliquee cote serveur.
  var MAX_ADVANCE_MONTHS = 6;

  var input      = document.getElementById(widget.getAttribute('data-input-id'));
  var container  = document.getElementById(widget.getAttribute('data-container-id'));
  var slotsUrl   = widget.getAttribute('data-slots-url');
  var locale     = widget.getAttribute('data-locale') || undefined;

  var monthLabelEl = widget.querySelector('.witty-slot-picker-month-label');
  var prevBtn       = widget.querySelector('.witty-slot-picker-prev');
  var nextBtn       = widget.querySelector('.witty-slot-picker-next');
  var weekdaysEl    = widget.querySelector('.witty-slot-picker-weekdays');
  var gridEl        = widget.querySelector('.witty-slot-picker-grid');
  var timesTitleEl  = widget.querySelector('.witty-slot-picker-times-title');
  var timesEl       = widget.querySelector('.witty-slot-picker-times');
  var statusEl      = widget.querySelector('.witty-slot-picker-status');
  var tzLabelEl     = widget.querySelector('.witty-slot-picker-tz-label');
  var tzSelectEl    = widget.querySelector('.witty-slot-picker-tz-select');

  // Meme catalogue (pas de granularite au-dela du 1/4 d'heure) que
  // MeetSlotAvailabilityCalculator::utcOffsetChoices() cote serveur : les
  // creneaux renvoyes par l'API restent des instants absolus (ISO 8601 avec
  // le decalage de l'organisateur), ce selecteur ne change QUE l'affichage
  // cote visiteur, jamais ce qui est envoye au serveur a la soumission.
  function buildOffsetMinutesList() {
    var list = [];
    for (var m = -12 * 60; m <= 14 * 60; m += 15) {
      list.push(m);
    }
    return list;
  }

  function formatOffset(minutes) {
    var sign = minutes < 0 ? '-' : '+';
    var abs  = Math.abs(minutes);
    var hh   = String(Math.floor(abs / 60)).padStart(2, '0');
    var mm   = String(abs % 60).padStart(2, '0');
    return sign + hh + ':' + mm;
  }

  function detectBrowserOffsetMinutes() {
    // Date.getTimezoneOffset() est le signe inverse d'un decalage UTC
    // ("minutes a AJOUTER pour obtenir UTC"), d'ou le -1.
    var raw = -new Date().getTimezoneOffset();
    // Alignement sur la granularite 1/4h du catalogue (les decalages reels
    // sont deja quasi tous des multiples de 15, ce round est defensif).
    return Math.round(raw / 15) * 15;
  }

  var offsetMinutesList  = buildOffsetMinutesList();
  var selectedOffsetMinutes = detectBrowserOffsetMinutes();
  if (offsetMinutesList.indexOf(selectedOffsetMinutes) === -1) {
    selectedOffsetMinutes = 0;
  }

  // Champ brut (pas un vrai champ Mautic) qui transmet le decalage choisi
  // par le visiteur : seul MeetSlotValidationSubscriber le lit, pour ecrire
  // le champ contact meeting_scheduled_visitor_at deja forme cote serveur
  // (cf. docblock de MeetSlotValidationSubscriber::updateContactMeetingFields()).
  // Rien d'autre a calculer/formater ici : le widget n'envoie que le
  // decalage brut, jamais un texte deja mis en forme.
  var visitorTzInput = document.getElementById(widget.getAttribute('data-visitor-tz-input-id'));

  function syncVisitorTzInput() {
    if (visitorTzInput) {
      visitorTzInput.value = formatOffset(selectedOffsetMinutes);
    }
  }

  function buildTimezoneSelector() {
    tzLabelEl.textContent = widget.getAttribute('data-label-your-timezone');

    tzSelectEl.innerHTML = offsetMinutesList.map(function (minutes) {
      return '<option value="' + minutes + '">UTC' + formatOffset(minutes) + '</option>';
    }).join('');
    tzSelectEl.value = String(selectedOffsetMinutes);
    syncVisitorTzInput();

    tzSelectEl.addEventListener('change', function () {
      selectedOffsetMinutes = parseInt(tzSelectEl.value, 10) || 0;
      syncVisitorTzInput();
      rerenderCurrentMonth();
    });
  }

  // Composantes "murales" (annee/mois/jour/heure/minute) d'un instant une
  // fois decale au fuseau choisi, calculees a la main (epoch + decalage puis
  // lecture des getters UTC) plutot que via Intl : coherent avec le decalage
  // fixe cote organisateur, pas de dependance a une base de fuseaux nommes.
  function shiftedDate(date) {
    return new Date(date.getTime() + selectedOffsetMinutes * 60000);
  }

  var today       = new Date();
  var minMonth    = startOfMonth(today);
  var maxMonth    = addMonths(minMonth, MAX_ADVANCE_MONTHS);
  var currentMonth = startOfMonth(today);
  var monthCache  = {};
  var selectedDayKey = null;

  function startOfMonth(d) {
    return new Date(d.getFullYear(), d.getMonth(), 1);
  }

  function addMonths(d, n) {
    return new Date(d.getFullYear(), d.getMonth() + n, 1);
  }

  function monthParam(d) {
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
  }

  // Cle de jour construite a partir d'entiers annee/mois(0-based)/jour, jamais
  // d'un Date directement : les cellules de la grille (annee/mois/jour de
  // calendrier, independants du fuseau) et les creneaux recus du serveur
  // (regroupes par jour APRES decalage au fuseau choisi, cf. shiftedDate) se
  // rejoignent sur ce meme format, generes par deux chemins differents.
  function dayKey(year, month, day) {
    return year + '-' + (month + 1) + '-' + day;
  }

  function dayKeyOfShifted(shifted) {
    return dayKey(shifted.getUTCFullYear(), shifted.getUTCMonth(), shifted.getUTCDate());
  }

  function setStatus(text) {
    statusEl.textContent = text || '';
  }

  function clearContainerError() {
    if (container) {
      container.classList.remove('mauticform-has-error');
      var msg = container.querySelector('.mauticform-errormsg');
      if (msg) {
        msg.style.display = 'none';
      }
    }
  }

  function renderHeader() {
    monthLabelEl.textContent = currentMonth.toLocaleDateString(locale, { month: 'long', year: 'numeric' });
    prevBtn.disabled = currentMonth.getTime() <= minMonth.getTime();
    nextBtn.disabled = currentMonth.getTime() >= maxMonth.getTime();
  }

  function renderWeekdays() {
    if (weekdaysEl.childElementCount) {
      return;
    }
    var ref = new Date(2023, 0, 2); // un lundi, sert juste de reference pour les libelles
    for (var i = 0; i < 7; i++) {
      var span = document.createElement('span');
      span.textContent = ref.toLocaleDateString(locale, { weekday: 'short' });
      weekdaysEl.appendChild(span);
      ref.setDate(ref.getDate() + 1);
    }
  }

  // Regroupe les creneaux bruts (recus une seule fois du serveur, jamais
  // re-fetches) par jour APRES decalage au fuseau actuellement choisi :
  // appele a chaque rendu (chargement de mois ET changement de fuseau), pas
  // seulement au chargement, puisque le meme instant absolu peut tomber sur
  // un jour different selon le fuseau d'affichage (proche de minuit).
  function computeByDay(rawSlots) {
    var byDay = {};
    rawSlots.forEach(function (item) {
      var shifted = shiftedDate(item.date);
      var dKey = dayKeyOfShifted(shifted);
      (byDay[dKey] = byDay[dKey] || []).push({ iso: item.iso, shifted: shifted });
    });
    return byDay;
  }

  function renderGrid(byDay) {
    gridEl.innerHTML = '';
    var year   = currentMonth.getFullYear();
    var month  = currentMonth.getMonth();
    var firstOfMonth = new Date(year, month, 1);
    var startOffset  = (firstOfMonth.getDay() + 6) % 7; // lundi = 0
    var daysInMonth  = new Date(year, month + 1, 0).getDate();

    for (var i = 0; i < startOffset; i++) {
      var filler = document.createElement('button');
      filler.type = 'button';
      filler.className = 'witty-slot-picker-day-cell is-outside';
      filler.disabled = true;
      gridEl.appendChild(filler);
    }

    for (var day = 1; day <= daysInMonth; day++) {
      (function (day) {
        var date = new Date(year, month, day);
        var key  = dayKey(year, month, day);
        var hasSlots = !!(byDay[key] && byDay[key].length);

        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'witty-slot-picker-day-cell';
        btn.textContent = String(day);

        if (!hasSlots) {
          btn.disabled = true;
        } else {
          btn.addEventListener('click', function () {
            selectDay(key, date, byDay);
          });
        }

        if (key === selectedDayKey) {
          btn.classList.add('is-selected');
        }

        gridEl.appendChild(btn);
      })(day);
    }
  }

  function selectDay(key, date, byDay) {
    selectedDayKey = key;
    renderGrid(byDay);
    renderTimes(key, date, byDay);
  }

  function renderTimes(key, date, byDay) {
    timesTitleEl.textContent = date.toLocaleDateString(locale, { weekday: 'long', day: 'numeric', month: 'long' });
    timesEl.innerHTML = '';

    (byDay[key] || []).forEach(function (slot) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'witty-slot-picker-time';
      // timeZone: 'UTC' : slot.shifted porte deja le fuseau choisi (epoch +
      // decalage, cf. shiftedDate) dans ses champs UTC. Sans ce forcage,
      // toLocaleTimeString reappliquerait EN PLUS le fuseau du navigateur.
      btn.textContent = slot.shifted.toLocaleTimeString(locale, { hour: '2-digit', minute: '2-digit', timeZone: 'UTC' });
      btn.addEventListener('click', function () {
        Array.prototype.forEach.call(timesEl.children, function (el) {
          el.classList.remove('is-selected');
        });
        btn.classList.add('is-selected');
        input.value = slot.iso;
        input.dispatchEvent(new Event('change', { bubbles: true }));
        input.dispatchEvent(new Event('input', { bubbles: true }));
        clearContainerError();
        setStatus(widget.getAttribute('data-label-selected') + ' ' + timesTitleEl.textContent + ' ' + btn.textContent);
      });
      timesEl.appendChild(btn);
    });
  }

  function afterLoad(rawSlots) {
    var byDay = computeByDay(rawSlots);
    renderGrid(byDay);

    var hasAnyDay = Object.keys(byDay).length > 0;

    if (!hasAnyDay) {
      timesTitleEl.textContent = '';
      timesEl.innerHTML = '';
      setStatus(widget.getAttribute('data-label-empty'));
      return;
    }

    setStatus('');

    if (!selectedDayKey || !byDay[selectedDayKey]) {
      timesTitleEl.textContent = widget.getAttribute('data-label-select-date');
      timesEl.innerHTML = '';
    } else {
      // Le jour selectionne reste visible (ex. apres un changement de
      // fuseau) : reaffiche ses creneaux avec les nouveaux libelles d'heure.
      var selectedDate = new Date(currentMonth.getFullYear(), currentMonth.getMonth(), parseInt(selectedDayKey.split('-')[2], 10));
      renderTimes(selectedDayKey, selectedDate, byDay);
    }
  }

  // Re-rendu pur (aucun appel reseau) apres un changement de fuseau choisi :
  // les creneaux bruts du mois affiche sont deja en cache, seul leur
  // regroupement par jour et leurs libelles d'heure dependent du fuseau.
  function rerenderCurrentMonth() {
    var key = monthParam(currentMonth);
    if (monthCache[key]) {
      afterLoad(monthCache[key]);
    }
  }

  function loadMonth(monthDate) {
    var key = monthParam(monthDate);
    renderHeader();

    if (monthCache[key]) {
      afterLoad(monthCache[key]);
      return;
    }

    setStatus(widget.getAttribute('data-label-loading'));

    fetch(slotsUrl + (slotsUrl.indexOf('?') === -1 ? '?' : '&') + 'month=' + key, { credentials: 'omit' })
      .then(function (response) {
        if (!response.ok) {
          throw new Error('http_error');
        }
        return response.json();
      })
      .then(function (data) {
        var rawSlots = (data.slots || []).map(function (iso) {
          return { iso: iso, date: new Date(iso) };
        });
        monthCache[key] = rawSlots;
        afterLoad(rawSlots);
      })
      .catch(function () {
        setStatus(widget.getAttribute('data-label-error'));
      });
  }

  prevBtn.addEventListener('click', function () {
    if (prevBtn.disabled) {
      return;
    }
    currentMonth = addMonths(currentMonth, -1);
    loadMonth(currentMonth);
  });

  nextBtn.addEventListener('click', function () {
    if (nextBtn.disabled) {
      return;
    }
    currentMonth = addMonths(currentMonth, 1);
    loadMonth(currentMonth);
  });

  buildTimezoneSelector();
  renderWeekdays();
  renderHeader();
  loadMonth(currentMonth);
  }
})();
</script>
{% endif %}
